# CRM Backend — Environment Variable Reference
# Copy this file to .env and fill in real values for local development.
# NEVER commit your real .env file — it is excluded by .gitignore.
#
# For Render deployment, set these in:
# Render Dashboard → your service → Environment → Environment Variables

# ─── Server ────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development        # Set to "production" on Render

# ─── Frontend (CORS) ───────────────────────────────────────────────────────
# Set to your actual Vercel deployment URL in production.
# Example: https://your-crm-project.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── JWT Authentication ────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-secret-32-chars-min
JWT_EXPIRES_IN=7d
COOKIE_NAME=access_token

# ─── Database ──────────────────────────────────────────────────────────────
# Local development (plain Postgres, no SSL):
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/crm
#
# Render PostgreSQL (internal URL — use this in render.yaml / Render dashboard):
# DATABASE_URL=postgresql+psycopg://user:password@dpg-XXXX-a/dbname
#
# Render PostgreSQL (external URL — for local testing against Render DB):
# DATABASE_URL=postgresql+psycopg://user:password@dpg-XXXX-a.oregon-postgres.render.com/dbname?sslmode=require

# ─── Google OAuth ──────────────────────────────────────────────────────────
# From: https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID of type "Web application"
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
